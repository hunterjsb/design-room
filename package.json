{
  "name": "design-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-agent.mjs && tsc --noEmit && vite build",
    "build:api": "node scripts/build-api.mjs",
    "test": "node --test tests/*.test.mjs",
    "board": "node scripts/board.mjs",
    "login": "node scripts/board.mjs login",
    "infra": "node scripts/infra.mjs",
    "setup:github": "node scripts/setup-github.mjs",
    "predev": "node scripts/build-agent.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.1155.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/s3-presigned-post": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@pulumi/aws": "6.83.4",
    "@pulumi/pulumi": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
